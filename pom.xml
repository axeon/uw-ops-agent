<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.umtone</groupId>
    <artifactId>uw-ops-agent</artifactId>
    <version>1.5.0</version>
    <packaging>jar</packaging>
    <name>uw-ops-agent</name>
    <description>宿主机监控、任务执行与自升级 Agent</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <graalvm.version>25.3.4.1</graalvm.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- ============ 自研框架 uw-* ============ -->
        <dependency>
            <groupId>com.umtone</groupId>
            <artifactId>uw-httpclient</artifactId>
            <version>2.3.6</version>
        </dependency>
        <!-- OpsAgentApi/ShellCmdUtils 直接使用 HmacUtils/JsonUtils 等（含 byte[][] 多段签名，
             1.1.116 起含 byte[][] 多段签名重载（116 为新发版本，勿回退）），显式声明对齐 uw-base 源码版本。 -->
        <dependency>
            <groupId>com.umtone</groupId>
            <artifactId>uw-common</artifactId>
            <version>1.1.116</version>
        </dependency>
        <!-- ============ 第三方业务 SDK ============ -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>7.3.1</version>
        </dependency>
        <!-- ============ 通用工具库 ============ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.18</version>
        </dependency>
        <!-- ============ Native Image build-time API ============ -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- project-info.properties 开启 filtering：pom 的 project.name/project.version 注入产品信息
                 （其余资源不过滤，避免 native-image 元数据被占位符改写）。 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>project-info.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>project-info.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>com.squareup.okhttp3:okhttp-jvm</artifact>
                                    <excludes>
                                        <exclude>META-INF/native-image/okhttp/okhttp/native-image.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>uw.ops.agent.MainService</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
